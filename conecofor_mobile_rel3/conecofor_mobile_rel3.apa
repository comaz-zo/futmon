<ArcPad debug="true">
	<APPLET onload="Call CEF_load_applet()">
		<TOOLBARS>
			<TOOLBAR name="CONECOFOR_Toolbar" caption="CONECOFOR" visible="true" image="conecofor_tlb.bmp">
				<TOOLBUTTON onclick="Call CEF_show_FrmSet()" name="CONECOFOR_BtnSetLayer" shortcut="" image="conecofor_set.bmp"/>
				<TOOLBUTTON onclick="Call CEF_show_FrmList()" name="CONECOFOR_BtnList" shortcut="" image="conecofor_lst.bmp"/>
				<TOOLBUTTON onclick="Call CEF_info_click()" name="CONECOFOR_BtnInfo" shortcut="" image="conecofor_info.bmp"/>
			</TOOLBAR>
		</TOOLBARS>
		<FORMS>
			<FORM name="CONECOFOR_FormSet" caption="Imposta Shapefile CONECOFOR" width="130" height="130" tabsvisible="false" onload="Call CEF_FrmSet_onload()">
				<PAGE name="S1" caption="Page1" onvalidate="CEF_FrmSet_PS1_onvalidate()">
					<LABEL name="lblLayerAree" x="1" y="0" width="100" height="10" caption="Layer CONECOFOR AREE:" fontstyle="bold" tooltip="" group="true" border="false"/>
					<LABEL name="lblLayerAreeVal" x="30" y="12" width="100" height="10" caption="" tooltip="" group="true" border="false"/>
					<LABEL name="lblLayerPiante" x="1" y="24" width="100" height="10" caption="Layer CONECOFOR PIANTE:" fontstyle="bold" tooltip="" group="true" border="false"/>
					<LABEL name="lblLayerPianteVal" x="30" y="36" width="100" height="10" caption="" tooltip="" group="true" border="false"/>
					<LABEL name="lblLayerSintomi" x="1" y="48" width="100" height="10" caption="DBF CONECOFOR SINTOMI:" fontstyle="bold" tooltip="" group="true" border="false"/>
					<LABEL name="lblLayerSintomiVal" x="30" y="60" width="100" height="10" caption="" tooltip="" group="true" border="false"/>
					<LABEL name="lblLayerCav" x="1" y="72" width="100" height="10" caption="DBF CONECOFOR CAV:" fontstyle="bold" tooltip="" group="true" border="false"/>
					<LABEL name="lblLayerCavVal" x="30" y="84" width="100" height="10" caption="" tooltip="" group="true" border="false"/>
					<LABEL name="lblLayerTabDec" x="1" y="96" width="100" height="10" caption="DBF TABDEC:" fontstyle="bold" tooltip="" group="true" border="false"/>
					<LABEL name="lblLayerTabDecVal" x="30" y="108" width="100" height="10" caption="" tooltip="" group="true" border="false"/>
				</PAGE>
			</FORM>
			<FORM name="CONECOFOR_FormLISTAREE" caption="LISTA AREE" width="130" height="130" tabsvisible="false" onload="Call CEF_FormLISTAREE_onload()" onunload="Call CEF_FormLISTAREE_onunload()">
				<PAGE name="PageLA1" caption="LA1" sip="false" onsetactive="Call CEF_FormLISTAREE_LA1_setactive()">
					<BUTTON name="BtnPREV10" width="14" height="14" caption="&lt;&lt;" tooltip="" tabstop="true" border="false" alignment="center" onclick="Call CEF_FormLISTAREE_BtnPREV10_click()"/>
					<BUTTON name="BtnPREV" x="14" width="14" height="14" caption="&lt;" tooltip="" tabstop="true" border="false" alignment="center" onclick="Call CEF_FormLISTAREE_BtnPREV_click()"/>
					<BUTTON name="BtnNEXT" x="100" width="14" height="14" caption="&gt;" tooltip="" tabstop="true" border="false" alignment="center" onclick="Call CEF_FormLISTAREE_BtnNEXT_click()"/>
					<BUTTON name="BtnNEXT10" x="114" width="14" height="14" caption="&gt;&gt;" tooltip="" tabstop="true" border="false" alignment="center" onclick="Call CEF_FormLISTAREE_BtnNEXT10_click()"/>
					<EDIT name="EditID" x="28" width="72" height="14" defaultvalue="" tooltip="" tabstop="true" border="true" readonly="true" sip="false" alignment="center"/>
					<BUTTON name="BtnNAV" x="0" y="18" width="64" height="20" onclick="Call CEF_btnNAV_Click()" caption="NAV ISTANT." tooltip="" tabstop="true" border="false" alignment="center"/>
					<BUTTON name="BtnNPM" x="64" y="18" width="64" height="20" onclick="Call CEF_btnNPM_Click()" caption="NAV MEDIA" tooltip="" tabstop="true" border="false" alignment="center"/>
					<BUTTON name="BtnDATIAREA" x="0" y="38" width="43" height="20" onclick="Call CEF_btnDATIAREA_Click()" caption="DATI AREA" tooltip="" tabstop="true" border="false" alignment="center"/>
					<BUTTON name="BtnLISTPIANTE" x="44" y="38" width="42" height="20" onclick="Call CEF_btnLISTPIANTE_Click()" caption="RICH" tooltip="" tabstop="true" border="false" alignment="center"/>
					<BUTTON name="BtnRILDENDRO" x="86" y="38" width="42" height="20" onclick="Call CEF_btnRILDENDRO_Click()" caption="RIDIA" tooltip="" tabstop="true" border="false" alignment="center"/>
					<LABEL name="LblIDONEITA" x="1" y="70" width="50" height="12" caption="Idoneita'" tooltip="" group="true" border="false"/>
					<LABEL name="LblIDONEITAV" x="55" y="70" width="60" height="12" caption="" tooltip="" group="true" border="false"/>
					<LABEL name="LblNOSINT" x="1" y="84" width="90" height="12" caption="Sintomi da inserire" tooltip="" group="true" border="false"/>
					<LABEL name="LblNOSINTV" x="91" y="84" width="20" height="12" caption="" tooltip="" group="true" border="false"/>
					<LABEL name="LblNCAV" x="1" y="98" width="90" height="12" caption="N Piante RIDIA" tooltip="" group="true" border="false"/>
					<LABEL name="LblNCAVV" x="91" y="98" width="20" height="12" caption="" tooltip="" group="true" border="false"/>
					<LABEL name="lblNHDOM" x="1" y="112" width="90" height="12" caption="N Altezze dom. RIDIA" tooltip="" group="true" border="false"/>
					<LABEL name="lblNHDOMV" x="91" y="112" width="20" height="12" caption="" tooltip="" group="true" border="false"/>
				</PAGE>
			</FORM>
			<FORM name="CONECOFOR_FormDATIAREA" caption="AREA" width="130" height="130" onload="Call CEF_FormDATIAREA_onload()" onok="Call CEF_FormDATIAREA_onok()">
				<PAGE name="PageDA1" caption="DA1" onvalidate="Call CEF_FormDATIAREA_DA1_validate()">
